# Obrigatório — gere uma string longa e aleatória
JWT_SECRET=troque_por_um_segredo_muito_longo_e_aleatorio

# Porta local (Railway injeta PORT automaticamente)
PORT=3001

# Em produção no Railway, aponte para o volume montado
# DB_PATH=/data/dentefacil.db

# Em produção, defina como production
NODE_ENV=development

# URL de origem permitida pelo CORS (em produção = URL do Railway)
# CORS_ORIGIN=https://seu-app.up.railway.app
CORS_ORIGIN=http://localhost:5173
